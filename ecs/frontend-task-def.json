{
  "family": "frontend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "076648863714.dkr.ecr.eu-north-1.amazonaws.com/frontend-repo:latest",
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/frontend",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "frontend"
        }
      }
    }
  ],
  "executionRoleArn": "arn:aws:iam::076648863714:role/ecsTaskExecutionRole"
}