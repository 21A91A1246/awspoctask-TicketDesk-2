{
  "family": "comment-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "comment-service",
      "image": "076648863714.dkr.ecr.eu-north-1.amazonaws.com/comment-service:latest",
      "portMappings": [
        {
          "containerPort": 8083,
          "hostPort": 8083,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "DB_HOST",
          "value": "ticketdesk-mysql.ch2ue6mwuudh.eu-north-1.rds.amazonaws.com"
        },
        {
          "name": "DB_PORT",
          "value": "3306"
        },
        {
          "name": "DB_USER",
          "value": "root"
        },
        {
          "name": "DB_PASSWORD",
          "value": "rootpassword123"
        },
        {
          "name": "USER_SERVICE_HOST",
          "value": "user-service.local"
        },
        {
          "name": "USER_SERVICE_PORT",
          "value": "8085"
        },
        {
          "name": "TICKET_SERVICE_HOST",
          "value": "ticket-service.local"
        },
        {
          "name": "TICKET_SERVICE_PORT",
          "value": "8082"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/comment-service",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "comment"
        }
      }
    }
  ],
  "executionRoleArn": "arn:aws:iam::076648863714:role/ecsTaskExecutionRole"
}